{
  "app_name": "Voice Prompt Tool",
  "log_level": "INFO",
  "history_limit": 100,
  "paths": {
    "logs_dir": "logs",
    "history_file": "data/history.json",
    "temp_dir": "temp",
    "models_dir": "models"
  },
  "tray": {
    "tooltip": "Voice Prompt Tool",
    "startup_notification": true
  },
  "notifications": {
    "enabled": true,
    "backend": "log"
  },
  "hotkey": {
    "combination": "ctrl+win"
  },
  "audio": {
    "sample_rate": 16000,
    "channels": 1,
    "block_frames": 1024,
    "max_record_seconds": 120,
    "min_duration_seconds": 0.35,
    "stale_temp_file_age_hours": 24,
    "file_prefix": "recording"
  },
  "transcription": {
    "model_size": "small",
    "language_mode": "ru",
    "device": "auto",
    "compute_type": "default",
    "cpu_threads": 0,
    "beam_size": 5,
    "best_of": 5,
    "condition_on_previous_text": false,
    "without_timestamps": false,
    "vad_filter": true,
    "initial_prompt": "Это русская диктовка. Точно распознавай слова. Сохраняй естественную пунктуацию. Не добавляй слов, которых нет в аудио.",
    "hotwords": "ChatGPT, OpenAI, React, TypeScript, Next.js",
    "language_detection_segments": 3
  },
  "live_preview": {
    "enabled": true,
    "model_size": "tiny",
    "language_mode": "ru",
    "device": "auto",
    "compute_type": "default",
    "beam_size": 1,
    "best_of": 1,
    "condition_on_previous_text": false,
    "without_timestamps": true,
    "vad_filter": false,
    "update_interval_seconds": 1.0,
    "min_audio_seconds": 1.0,
    "max_preview_window_seconds": 8.0
  },
  "text_postprocess": {
    "auto_copy": true,
    "auto_paste": true,
    "custom_replacements": {
      "чат gpt": "ChatGPT",
      "опен эй ай": "OpenAI",
      "реакт": "React",
      "тайпскрипт": "TypeScript",
      "некст джей эс": "Next.js"
    }
  }
}
